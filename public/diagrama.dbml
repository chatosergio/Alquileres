 table properties {
    id int [pk, increment]
    tipo varchar(50)
    direccion varchar(200)
    precio decimal(10,2)
    descripcion text
    estado varchar(50)
    created_at timestamp
    updated_at timestamp
}
table trents {
    id int [pk, increment]
    nombre varchar(35)
    apellido varchar(35)
    cedula varchar(20)
    email varchar(100)
    telefono varchar(20)
    created_at timestamp
    updated_at timestamp
}